{
  "name": "whatsapp-ai-manager",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "pnpm --dir apps/admin-web build",
    "build": "pnpm build:server && pnpm build:web",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && pnpm --dir apps/admin-web typecheck",
    "lint": "eslint apps packages tests",
    "test": "vitest run tests/unit tests/architecture tests/contract",
    "test:integration": "pnpm build:server && vitest run tests/integration --maxWorkers=1",
    "db:migrate": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/migrate.ts",
    "bootstrap": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/bootstrap.ts",
    "start:api": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "start:jobs": "node --env-file-if-exists=.env dist/apps/job-worker/src/main.js",
    "start:gateway": "node --env-file-if-exists=.env dist/apps/gateway-worker/src/main.js",
    "dev:web": "pnpm --dir apps/admin-web dev",
    "format": "prettier --write apps packages tests infrastructure/scripts",
    "test:e2e": "pnpm build:server && playwright test",
    "dev": "bash infrastructure/scripts/dev.sh",
    "setup:local": "bash infrastructure/scripts/setup-local.sh",
    "test:load": "node --env-file-if-exists=.env --import tsx tests/load/baseline.ts",
    "test:restore": "node --env-file-if-exists=.env --import tsx tests/operations/restore.ts",
    "test:containers": "node --env-file-if-exists=.env --import tsx tests/operations/containers.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "argon2": "^0.44.0",
    "bullmq": "6.3.15",
    "drizzle-orm": "0.45.4",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0",
    "exceljs": "^4.4.0",
    "fastify": "5.12.5",
    "socket.io": "4.8.3",
    "ioredis": "5.8.2",
    "@fastify/static": "10.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "5.0.4",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.6.0",
    "@playwright/test": "^1.58.2"
  },
  "type": "module"
}
