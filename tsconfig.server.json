{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/gateway-worker/**/*.ts",
    "apps/job-worker/**/*.ts",
    "packages/**/*.ts",
    "infrastructure/scripts/**/*.ts"
  ]
}
